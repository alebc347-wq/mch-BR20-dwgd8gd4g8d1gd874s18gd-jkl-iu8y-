# Discord Bot Token (從 Discord Developer Portal 取得)
DISCORD_TOKEN=your_bot_token_here

# Bot 設定
BOT_PREFIX=.
OWNER_ID=your_discord_user_id

# Lavalink 設定 (音樂系統)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# GitHub 自動同步與更新設定
GITHUB_REPO=your_username/your_repo_name
GITHUB_BRANCH=main
# 若為私有倉庫，請填寫 Personal Access Token；公開倉庫則不需填寫
GITHUB_TOKEN=

# 多主機主備容災與總控中心設定
# 此主機是否為總控中心網頁 (true/false)；在專門跑網頁的主機上設為 true
RUN_DASHBOARD=false
# 此主機的伺服器 ID (例如：wispbyte-1, wispbyte-2 等，各機器人伺服器必須不同)
SERVER_ID=
# 總控中心網頁網址 (例如：http://node.wispbyte.com:port，各機器人伺服器必須設定以連線總控)
DASHBOARD_URL=
